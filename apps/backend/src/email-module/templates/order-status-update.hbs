<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{subject}}</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background-color: #f5f5f5;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
        }
        .header {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }
        .header h1 {
            margin: 0;
            font-size: 24px;
            font-weight: 600;
        }
        .content {
            padding: 30px;
        }
        .status-box {
            background-color: #dbeafe;
            border: 2px solid #3b82f6;
            border-radius: 8px;
            padding: 20px;
            text-align: center;
            margin: 20px 0;
        }
        .status-icon {
            font-size: 48px;
            margin-bottom: 10px;
        }
        .order-details {
            background-color: #f9fafb;
            border-radius: 8px;
            padding: 20px;
            margin: 20px 0;
        }
        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid #e5e7eb;
        }
        .detail-row:last-child {
            border-bottom: none;
        }
        .detail-label {
            color: #6b7280;
            font-size: 14px;
        }
        .detail-value {
            font-weight: 600;
            color: #1f2937;
        }
        .timeline {
            margin: 20px 0;
        }
        .timeline-item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 15px;
        }
        .timeline-icon {
            width: 32px;
            height: 32px;
            background-color: #10b981;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 16px;
            margin-right: 12px;
            flex-shrink: 0;
        }
        .timeline-item.active .timeline-icon {
            background-color: #3b82f6;
        }
        .timeline-item.pending .timeline-icon {
            background-color: #d1d5db;
        }
        .timeline-content {
            flex: 1;
        }
        .timeline-title {
            font-weight: 600;
            color: #1f2937;
            font-size: 14px;
        }
        .timeline-desc {
            color: #6b7280;
            font-size: 13px;
            margin-top: 2px;
        }
        .footer {
            background-color: #f9fafb;
            padding: 20px;
            text-align: center;
            font-size: 12px;
            color: #6b7280;
            border-top: 1px solid #e5e7eb;
        }
        .badge {
            display: inline-block;
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
        }
        .badge-confirmed { background-color: #d1fae5; color: #065f46; }
        .badge-preparing { background-color: #fef3c7; color: #92400e; }
        .badge-ready { background-color: #e0e7ff; color: #3730a3; }
        .badge-delivery { background-color: #fce7f3; color: #9f1239; }
        .badge-delivered { background-color: #d1fae5; color: #065f46; }
        .badge-cancelled { background-color: #fee2e2; color: #991b1b; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📍 Order Status Update</h1>
            <p>Order #{{orderId}}</p>
        </div>

        <div class="content">
            <div class="status-box">
                <div class="status-icon">🔔</div>
                <h2>{{statusMessage}}</h2>
                <p>Hello, {{customerName}}! Your order status has been updated.</p>
            </div>

            <div class="order-details">
                <div class="detail-row">
                    <span class="detail-label">Order ID</span>
                    <span class="detail-value">#{{orderId}}</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Current Status</span>
                    <span class="detail-value">
                        {{#if (eq status 'CONFIRMED')}}<span class="badge badge-confirmed">✓ Confirmed</span>{{/if}}
                        {{#if (eq status 'PREPARING')}}<span class="badge badge-preparing">👨‍🍳 Preparing</span>{{/if}}
                        {{#if (eq status 'READY')}}<span class="badge badge-ready">📦 Ready</span>{{/if}}
                        {{#if (eq status 'OUT_FOR_DELIVERY')}}<span class="badge badge-delivery">🚚 Out for Delivery</span>{{/if}}
                        {{#if (eq status 'DELIVERED')}}<span class="badge badge-delivered">✓ Delivered</span>{{/if}}
                        {{#if (eq status 'CANCELLED')}}<span class="badge badge-cancelled">✗ Cancelled</span>{{/if}}
                    </span>
                </div>
            </div>

            <h3>📋 Order Progress</h3>
            <div class="timeline">
                <div class="timeline-item {{#if (or (eq status 'CONFIRMED') (eq status 'PREPARING') (eq status 'READY') (eq status 'OUT_FOR_DELIVERY') (eq status 'DELIVERED'))}}active{{else}}pending{{/if}}">
                    <div class="timeline-icon">✓</div>
                    <div class="timeline-content">
                        <div class="timeline-title">Order Confirmed</div>
                        <div class="timeline-desc">We've received your order</div>
                    </div>
                </div>
                <div class="timeline-item {{#if (or (eq status 'PREPARING') (eq status 'READY') (eq status 'OUT_FOR_DELIVERY') (eq status 'DELIVERED'))}}active{{else}}pending{{/if}}">
                    <div class="timeline-icon">👨‍🍳</div>
                    <div class="timeline-content">
                        <div class="timeline-title">Preparing</div>
                        <div class="timeline-desc">Our chefs are preparing your food</div>
                    </div>
                </div>
                <div class="timeline-item {{#if (or (eq status 'READY') (eq status 'OUT_FOR_DELIVERY') (eq status 'DELIVERED'))}}active{{else}}pending{{/if}}">
                    <div class="timeline-icon">📦</div>
                    <div class="timeline-content">
                        <div class="timeline-title">Ready</div>
                        <div class="timeline-desc">Your order is ready for delivery</div>
                    </div>
                </div>
                <div class="timeline-item {{#if (or (eq status 'OUT_FOR_DELIVERY') (eq status 'DELIVERED'))}}active{{else}}pending{{/if}}">
                    <div class="timeline-icon">🚚</div>
                    <div class="timeline-content">
                        <div class="timeline-title">Out for Delivery</div>
                        <div class="timeline-desc">Your order is on its way</div>
                    </div>
                </div>
                <div class="timeline-item {{#if (eq status 'DELIVERED')}}active{{else}}pending{{/if}}">
                    <div class="timeline-icon">🏠</div>
                    <div class="timeline-content">
                        <div class="timeline-title">Delivered</div>
                        <div class="timeline-desc">Enjoy your meal!</div>
                    </div>
                </div>
            </div>

            <p style="color: #6b7280; font-size: 14px; text-align: center; margin-top: 20px;">
                You'll continue to receive real-time updates as your order progresses.
                Thank you for choosing Foodie Restaurant!
            </p>
        </div>

        <div class="footer">
            <p>© {{year}} Foodie Restaurant. All rights reserved.</p>
            <p>Need help? Contact us at support@foodierestaurant.com</p>
        </div>
    </div>
</body>
</html>
