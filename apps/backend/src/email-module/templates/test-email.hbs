<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{subject}}</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background-color: #f5f5f5;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
        }
        .header {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }
        .content {
            padding: 30px;
        }
        .success-box {
            background-color: #d1fae5;
            border: 2px solid #10b981;
            border-radius: 8px;
            padding: 20px;
            text-align: center;
            margin: 20px 0;
        }
        .success-icon {
            font-size: 48px;
            margin-bottom: 10px;
        }
        .footer {
            background-color: #f9fafb;
            padding: 20px;
            text-align: center;
            font-size: 12px;
            color: #6b7280;
            border-top: 1px solid #e5e7eb;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🧪 Test Email</h1>
        </div>

        <div class="content">
            <div class="success-box">
                <div class="success-icon">✅</div>
                <h2>Email Configuration Successful!</h2>
                <p>Congratulations {{testName}}!</p>
                <p>Your email service is working perfectly.</p>
            </div>

            <h3>Configuration Details:</h3>
            <ul>
                <li>SMTP Host: Successfully connected</li>
                <li>Authentication: Verified</li>
                <li>Email Template: Rendered correctly</li>
                <li>Timestamp: {{timestamp}}</li>
            </ul>

            <p style="color: #6b7280; font-size: 14px; margin-top: 20px;">
                This is a test email from Foodie Restaurant's automated email service.
            </p>
        </div>

        <div class="footer">
            <p>© {{year}} Foodie Restaurant. All rights reserved.</p>
        </div>
    </div>
</body>
</html>
